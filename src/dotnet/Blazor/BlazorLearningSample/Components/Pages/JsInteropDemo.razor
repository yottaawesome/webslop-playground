@page "/jsinterop"
@rendermode InteractiveServer
@inject IJSRuntime JS

<PageTitle>JS interop</PageTitle>

<h1>JavaScript interop</h1>

<p>
    Sometimes you need to call a JS API (e.g. <code>localStorage</code>,
    <code>alert</code>, a charting library). Inject <code>IJSRuntime</code>
    and call <code>InvokeVoidAsync</code> / <code>InvokeAsync&lt;T&gt;</code>.
</p>

<p>
    Important: <code>IJSRuntime</code> cannot be used during static server
    rendering (there's no browser yet). It's only safe from
    <code>OnAfterRenderAsync</code> onwards, or inside user-triggered handlers.
</p>

<button class="btn btn-primary" @onclick="ShowAlertAsync">
    Call window.alert
</button>

<button class="btn btn-outline-primary ms-2" @onclick="SaveToStorageAsync">
    Save value to localStorage
</button>

<button class="btn btn-outline-secondary ms-2" @onclick="ReadFromStorageAsync">
    Read it back
</button>

<p class="mt-3">Last read value: <code>@lastRead</code></p>

@code {
    private string? lastRead;

    private async Task ShowAlertAsync()
    {
        // Fire-and-forget: no return value to marshal back.
        await JS.InvokeVoidAsync("alert", "Hello from C#!");
    }

    private async Task SaveToStorageAsync()
    {
        await JS.InvokeVoidAsync(
            "localStorage.setItem", "blazor-sample", DateTime.Now.ToString("O"));
    }

    private async Task ReadFromStorageAsync()
    {
        // Generic InvokeAsync<T> — JS value is serialised to T.
        lastRead = await JS.InvokeAsync<string?>("localStorage.getItem", "blazor-sample");
    }
}
